#!/usr/bin/env python

"""Omnifocus to Kanban

Usage:
  of-to-kb.py (--trello | --leankit | --kanbanflow | --plane) [--eval]
  of-to-kb.py -h | --help
  of-to-kb.py --version

"""
import sys
import os
import logging
import logging.config
from timeit import default_timer as timer
from typing import List, Dict, Any, Union
from docopt import docopt
from kanban_board import KanbanFlow
from plane_kanban_board import PlaneKanbanBoard
from omnifocus import Omnifocus

# Constants
CONFIG_PATH = './config/log.conf'
KANBANFLOW_OPTION = '--kanbanflow'
PLANE_OPTION = '--plane'


def setup_logging() -> None:
    """Set up logging configuration."""
    logging.config.fileConfig(CONFIG_PATH)
    logging.debug(f"sys.path: {sys.path}")
    logging.debug(f"sys.executable: {sys.executable}")
    logging.debug(f"os.getcwd(): {os.getcwd()}")


def connect_to_board(opts: Dict[str, Any]) -> Union[KanbanFlow, PlaneKanbanBoard]:
    """Connect to the appropriate Kanban board based on options."""
    if opts[KANBANFLOW_OPTION]:
        logging.debug("Connecting to KanbanFlow board")
        return KanbanFlow()
    elif opts[PLANE_OPTION]:
        logging.debug("Connecting to Plane.so board")
        # You'll need to provide these values from your configuration
        api_key = os.environ.get('PLANE_API_KEY')
        workspace_id = os.environ.get('PLANE_WORKSPACE_ID')
        project_id = os.environ.get('PLANE_PROJECT_ID')
        return PlaneKanbanBoard(api_key, workspace_id, project_id)
    else:
        raise ValueError(f"Expected {KANBANFLOW_OPTION} or {PLANE_OPTION}")


def process_tasks(board: Union[KanbanFlow, PlaneKanbanBoard], omnifocus: Omnifocus, external_ids: List[str]) -> str:
    """Process tasks and return a result string."""
    tasks_closed, repeating_tasks_closed = omnifocus.close_tasks(external_ids)
    cards_to_add = omnifocus.flagged_tasks().values()
    
    if isinstance(board, KanbanFlow):
        board.remove_comments_from_repeating_tasks(repeating_tasks_closed)
        cards_added = board.add_cards(cards_to_add)
    elif isinstance(board, PlaneKanbanBoard):
        # Implement Plane.so specific logic here
        cards_added = board.create_tasks(cards_to_add)
    
    return f"{cards_added} update(s), {len(tasks_closed)} task(s) closed & {len(repeating_tasks_closed)} repeating tasks closed"


def main() -> None:
    start = timer()
    opts = docopt(__doc__)

    try:
        board = connect_to_board(opts)
        external_ids = board.find_completed_card_ids()
        omnifocus = Omnifocus()

        if not opts['--eval']:
            result = process_tasks(board, omnifocus, external_ids)
            elapsed_time = timer() - start
            logging.debug(f"{result} in {elapsed_time:.2f}s")
        else:
            cards_to_add = omnifocus.flagged_tasks().values()
            result = f"To close: {external_ids}\nTo add: {cards_to_add}"

        print(result)

    except ValueError as e:
        logging.error(f"Invalid option: {e}")
        sys.exit(1)
    except IOError as e:
        logging.error(f"Failed to connect to kanban board: {e}")
        sys.exit(2)
    except Exception as e:
        logging.error(f"Unexpected error: {e}")
        sys.exit(3)


if __name__ == '__main__':
    setup_logging()
    main()

